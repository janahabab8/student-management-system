<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.finalpro.AddGradesController">

    <TextField fx:id="studentIdField" promptText="Student ID" />

    <TextField fx:id="courseField" promptText="Course Name" />

    <TextField fx:id="gradeField" promptText="Grade" />

    <Button onAction="#handleSaveGrade" text="Save Grade" />

    <Label fx:id="messageLabel" />
   <Button mnemonicParsing="false" onAction="#handleBack" text="Back" />

</VBox>
